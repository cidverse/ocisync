{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cidverse/ocisync/main/configschema/v1.json",
  "title": "ocisync config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registries",
    "images"
  ],
  "properties": {
    "registries": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/registryConfig"
      }
    },
    "push-strategy": {
      "$ref": "#/$defs/pushStrategy"
    },
    "images": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/imageConfig"
      }
    },
    "patches": {
      "type": "object",
      "description": "Named patches that images can reference to modify container images before they are pushed to the target.",
      "additionalProperties": {
        "$ref": "#/$defs/patchConfig"
      }
    }
  },
  "$defs": {
    "pushStrategy": {
      "type": "string",
      "enum": [
        "IfNotPresent",
        "Always"
      ]
    },
    "registryConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "oci",
            "helm-repo"
          ]
        },
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "format": "uri"
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "description": "Username for basic auth / token exchange; the token is used as password. Without a username the token is sent as bearer token."
        },
        "token": {
          "type": "string",
          "minLength": 1
        },
        "token-env": {
          "type": "string",
          "minLength": 1
        },
        "token-command": {
          "type": "string",
          "minLength": 1
        },
        "insecure": {
          "type": "boolean",
          "description": "oci: connect to the registry over plain HTTP. helm-repo: skip TLS certificate verification (HTTP vs. HTTPS is taken from the url)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "helm-repo"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "url"
            ]
          },
          "else": {
            "required": [
              "registry"
            ]
          }
        }
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "token",
              "token-env"
            ]
          },
          {
            "required": [
              "token",
              "token-command"
            ]
          },
          {
            "required": [
              "token-env",
              "token-command"
            ]
          }
        ]
      },
      "dependentSchemas": {
        "username": {
          "anyOf": [
            {
              "required": [
                "token"
              ]
            },
            {
              "required": [
                "token-env"
              ]
            },
            {
              "required": [
                "token-command"
              ]
            }
          ]
        }
      }
    },
    "imageConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source-type": {
          "type": "string",
          "enum": [
            "oci",
            "helm-repo"
          ]
        },
        "source-registry": {
          "type": "string",
          "minLength": 1
        },
        "target-registry": {
          "type": "string",
          "minLength": 1
        },
        "source-repository": {
          "type": "string",
          "minLength": 1
        },
        "target-repository": {
          "type": "string",
          "minLength": 1
        },
        "regex": {
          "type": "string"
        },
        "semver": {
          "$ref": "#/$defs/semverFilter"
        },
        "push-strategy": {
          "$ref": "#/$defs/pushStrategy"
        },
        "patches": {
          "type": "array",
          "description": "Names of patches (from the top-level patches) applied to the image, in order. Only for source-type oci; patched images get new digests.",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "semverFilter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "constraint": {
          "type": "string"
        },
        "include-prerelease": {
          "type": "boolean"
        }
      }
    },
    "patchConfig": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "ca-certificates": {
          "$ref": "#/$defs/caCertificatesPatch"
        }
      }
    },
    "caCertificatesPatch": {
      "type": "object",
      "additionalProperties": false,
      "description": "Adds CA certificates to the system CA bundles of the image (Debian/Ubuntu/Alpine, RHEL/Fedora/UBI, SUSE, Arch, ...) and to the anchor directories of the distribution trust tooling.",
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "description": "PEM files with one or more certificates, relative to the config file.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "env": {
          "type": "boolean",
          "description": "Set CA environment variables for runtimes with their own CA store, unless the image already sets them: SSL_CERT_FILE, REQUESTS_CA_BUNDLE, AWS_CA_BUNDLE, PIP_CERT, CLOUDSDK_CORE_CUSTOM_CA_CERTS_FILE, HEX_CACERTS_PATH (patched bundle), DENO_TLS_CA_STORE=system and NODE_EXTRA_CA_CERTS (only the added certificates)."
        },
        "on-missing-bundle": {
          "type": "string",
          "enum": [
            "fail",
            "skip",
            "create"
          ],
          "description": "What to do if the image contains no CA bundle: fail (default), skip (copy without certificate changes), or create /etc/ssl/certs/ca-certificates.crt with only the configured certificates."
        },
        "base": {
          "type": "string",
          "enum": [
            "image",
            "system"
          ],
          "description": "Bundle the certificates are added to: image (default) appends them to the bundles of the image; system replaces the image bundles with the CA bundle of the system running ocisync ($SSL_CERT_FILE or the first well-known bundle path) plus the certificates."
        },
        "java": {
          "type": "string",
          "enum": [
            "replace",
            "env",
            "none"
          ],
          "description": "Java truststores, built (JKS) from the patched CA bundle: replace (default) overwrites every JDK cacerts and distribution java truststore in the image; env writes /etc/ssl/certs/java/ocisync-<patch>.jks and selects it via JAVA_TOOL_OPTIONS; none leaves them alone. Images without a JDK/JRE are not changed."
        }
      }
    }
  }
}
